{
  "name": "mallorca-route-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "privacy:scan": "node scripts/assert-private-boundary.mjs --tracked --history",
    "privacy:scan:dist": "node scripts/assert-private-boundary.mjs --dist",
    "privacy:scan:release": "node scripts/assert-private-boundary.mjs --tracked --history --dist --require-denylist",
    "encrypt:itinerary": "node scripts/encrypt-private-itinerary.mjs",
    "build": "npm run privacy:scan && vite build && node scripts/prepare-sites-build.mjs && npm run privacy:scan:dist",
    "preview": "vite preview",
    "test:private": "node --test tests/private-itinerary.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
